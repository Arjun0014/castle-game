{
  "name": "time-castle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Caer Veyr - third-person Past/Present castle action game (Three.js).",
  "scripts": {
    "predev": "node tools/build_floor_manifest.mjs",
    "dev": "vite --port 5173 --strictPort",
    "prebuild": "node tools/build_floor_manifest.mjs",
    "build": "tsc --noEmit && vite build",
