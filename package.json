    "typecheck": "tsc --noEmit",
    "assets:extract": "python tools/extract_assets.py",
    "assets:textures": "python tools/build_textures.py",
    "assets:hero": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python tools/blender/build_hero.py",
    "assets:enemies": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python tools/blender/build_enemies.py",
    "assets:floor01": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python tools/blender/build_floor01.py",
    "assets:audio": "python tools/build_audio.py",
    "assets:floor02": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python tools/blender/build_floor02.py",
    "assets:manifest": "node tools/build_floor_manifest.mjs",
    "assets:ktx2": "node tools/build_ktx2.mjs",
    "assets:sfx": "node tools/elevenlabs_sfx.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
